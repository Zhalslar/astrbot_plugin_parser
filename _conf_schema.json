                        "slider": {
                            "min": 0,
                            "max": 3600,
                            "step": 30
                        },
                        "default": 300
                    },
                    "cookies": {
                        "description": "手动 Cookies（备用）",
                        "hint": "选填；SnowLuma 自动获取失败时作为备用。建议包含 uin/p_uin、skey、p_skey。选择“仅手动 Cookies”时直接使用这里。",
                        "type": "text",
                        "default": ""
                    },
