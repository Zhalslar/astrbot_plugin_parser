                    "cookies": {
                        "description": "Cookies",
                        "hint": "选填",
                        "type": "text",
                        "default": ""
                    },
                    "video_codec_list": {
                        "description": "B站视频编码",
                        "hint": "优先下载的编码类型，可选：AVC、AV1、HEV。失败时会按列表依次回退",
                        "type": "list",
                        "options": [
                            "AVC",
                            "AV1",
                            "HEV"
                        ],
                        "default": [
                            "AVC",
                            "AV1",
                            "HEV"
                        ]
                    },
                    "video_quality": {
                        "description": "B站视频分辨率",
                        "hint": "下载B站视频的分辨率, 高画质可能需要登录才能下载成功",
                        "type": "string",
                        "options": [
                            "_360P",
                            "_480P",
